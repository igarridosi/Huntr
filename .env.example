# Huntr — environment variables
#
# Copy to `.env` (or `.env.local`) and fill in. Every variable the code reads
# via process.env is listed here; nothing else is consulted. Values marked
# "required" stop the app from working when missing; the rest degrade
# gracefully to mock data, a default, or a disabled feature.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project URL, from Supabase → Settings → API. Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon (public) key. Row Level Security is what keeps this safe to expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server only — used by the cron routes and the cache writer
# to bypass RLS. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Market data (optional) ──────────────────────────────────────────────────
# Alpha Vantage key for the financial-statements enrichment path. Without it
# the app falls back to Yahoo Finance for everything (free, no key needed).
ALPHAVANTAGE_API_KEY=
# Identifies the app to SEC EDGAR, which requires a contact in the User-Agent.
# Defaults to the project's own string; set to your own if you fork.
SEC_USER_AGENT="Huntr huntrvalue.me contact@huntrvalue.me"
# Python interpreter for the optional yfinance bridge script. Defaults to "python".
PYTHON_BIN=python

# ── Deployment (optional) ───────────────────────────────────────────────────
# Public origin used to build auth redirect URLs. Defaults to the current
# window origin in the browser; set it when that differs (preview deploys).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret the Vercel cron jobs send as `Authorization: Bearer <secret>`.
# Required in production for /api/cron/* to run; unused locally.
CRON_SECRET=
